# === Users (auth) ===
# Either MCP_USERS_JSON (single-line JSON) or leave empty to use config/users.json
MCP_USERS_JSON=

# === Meta Marketing API (single BM partner token) ===
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_GRAPH_VERSION=v21.0

# === Google Ads (agency MCC OAuth) ===
GADS_DEVELOPER_TOKEN=
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=
GADS_LOGIN_CUSTOMER_ID=
GADS_API_VERSION=v18

# === Google (Sheets + GA4 share the same service account) ===
GOOGLE_SERVICE_ACCOUNT_JSON=

# === Clients registry override (optional) ===
# CLIENTS_JSON=

# === Server ===
PORT=3000
