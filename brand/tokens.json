{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Break — Sistema de diseño (2 variantes)",
    "version": "2.0.0",
    "extractedAt": "2026-09-24",
    "variants": {
      "deck": {
        "purpose": "Informes de resultados para clientes (formato deck scrolleable)",
        "source": "https://azahares-embudo-sep2026-v1.netlify.app/"
      },
      "doc": {
        "purpose": "Docs, handoffs y guías internas (formato columna angosta)",
        "source": "https://performance-nodo-conexion-claude.netlify.app/"
      }
    }
  },
  "color": {
    "bg": "#F5F3F7",
    "black": "#1B1B1D",
    "dark": "#2A292A",
    "gray": "#656467",
    "light": "#DDDDDD",
    "white": "#FFFFFF",
    "border": "#DDDDDD",
    "brand": {
      "blue": "#0087F2",
      "purple": "#BF4FCD",
      "pink": "#E13B7D",
      "coral": "#EE394D"
    },
    "gradient": {
      "primary": "linear-gradient(135deg,#0087F2 0%,#BF4FCD 50%,#E13B7D 100%)",
      "stops": ["#0087F2", "#BF4FCD", "#E13B7D"],
      "angle": 135
    },
    "onDark": {
      "textStrong": "#FFFFFF",
      "textDim": "rgba(255,255,255,0.45)",
      "border": "rgba(255,255,255,0.14)",
      "hotSurface": "#221F25",
      "colHot": "#232026"
    },
    "funnelBands": {
      "b1_light": "#E4DFEA",
      "b2_lightMid": "#D2C9DC",
      "b3_blue": "#0087F2",
      "b4_indigo": "#5B6FE6",
      "b5_violet": "#9658D6",
      "b6_magenta": "#C44BB8",
      "b7_pink": "#E13B7D"
    }
  },
  "typography": {
    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap",
    "weights": [300, 400, 500, 600, 700, 800, 900],
    "numericFeature": "tabular-nums",
    "base": {
      "size": "15px",
      "lineHeight": 1.55,
      "smoothing": "antialiased"
    },
    "h1": {
      "sizeClamp": "clamp(2.6rem,6.6vw,6rem)",
      "weight": 900,
      "letterSpacing": "-0.045em",
      "lineHeight": 0.93,
      "textWrap": "balance"
    },
    "h2": {
      "sizeClamp": "clamp(1.9rem,3.8vw,3.2rem)",
      "weight": 800,
      "letterSpacing": "-0.035em",
      "lineHeight": 1.04
    },
    "h3": {
      "size": "1.02rem",
      "weight": 700,
      "letterSpacing": "-0.01em"
    },
    "eyebrow": {
      "size": "0.68rem",
      "weight": 600,
      "letterSpacing": "0.16em",
      "textTransform": "uppercase",
      "color": "gray"
    },
    "lede": {
      "sizeClamp": "clamp(1rem,1.3vw,1.12rem)",
      "weight": 300,
      "color": "gray",
      "maxWidth": "56ch"
    },
    "kpi": {
      "number": {
        "sizeClamp": "clamp(2.2rem,4.2vw,3.8rem)",
        "weight": 900,
        "letterSpacing": "-0.045em",
        "lineHeight": 1
      },
      "label": {
        "size": "0.68rem",
        "weight": 600,
        "letterSpacing": "0.14em",
        "textTransform": "uppercase"
      },
      "sub": {
        "size": "0.8rem",
        "color": "rgba(255,255,255,0.7)"
      }
    }
  },
  "layout": {
    "container": {
      "maxWidth": "1180px",
      "align": "center"
    },
    "slide": {
      "minHeight": "100svh",
      "scrollSnap": "y mandatory",
      "paddingTop": "clamp(88px,11vh,116px)",
      "paddingX": "clamp(16px,5vw,4.5rem)",
      "paddingBottom": "clamp(40px,6vh,60px)",
      "backgrounds": ["s-black", "s-white", "s-bg"]
    },
    "header": {
      "position": "fixed",
      "topBarHeight": "2px",
      "topBarBackground": "gradient.primary",
      "navPadding": "0.9rem clamp(16px,4vw,3rem)",
      "navBackground": "rgba(245,243,247,0.92)",
      "backdropFilter": "blur(14px)",
      "borderBottom": "1px solid #DDDDDD"
    },
    "grid": {
      "kpis4": "repeat(4,1fr) with 1px gap on faint-white bg",
      "facts3": "repeat(3,1fr) with 1px gap on border color",
      "keys3": "repeat(3,1fr) 2rem gap, each has 2px top border in --black",
      "pipeline": "1.25fr 1fr 1fr 1fr"
    },
    "breakpoints": {
      "tablet": "900px",
      "mobile": "540px"
    }
  },
  "components": {
    "logo": {
      "type": "text",
      "structure": "'<slug>' + <gradient dot>",
      "compositeExample": "azahares· × break·",
      "fontWeight": 400,
      "size": "1.2rem",
      "letterSpacing": "-0.01em",
      "dot": {
        "size": "6x6px",
        "background": "gradient.primary",
        "borderRadius": "50%",
        "verticalAlign": "super"
      }
    },
    "pager": {
      "position": "top-right in nav",
      "item": {
        "width": "22px",
        "height": "3px",
        "inactive": "#B9B5BF",
        "active": "gradient.primary",
        "gap": "6px"
      }
    },
    "kpi": {
      "grid": "1px gaps forming a matrix on dark bg",
      "padding": "1.5rem 1.5rem 1.3rem",
      "highlight": {
        "background": "#221F25",
        "numberStyle": "gradient text (background-clip:text)"
      }
    },
    "funnel": {
      "layout": "3 columns: cost | bands | conversion",
      "bandRowHeight": "62px",
      "bandRowGap": "5px",
      "bandShape": "trapezoid via clip-path polygon narrowing ~7% per step",
      "bandWidths": [100, 86, 72, 60, 49, 39, 30],
      "bandAnimation": "drop 0.6s ease with 0.06s stagger per band"
    },
    "cbar": {
      "border": "1px solid --border top and bottom",
      "trackHeight": "10px",
      "trackBg": "rgba(27,27,29,0.06)",
      "fillDefault": "--black",
      "fillBest": "gradient.primary",
      "fillWorst": "--coral",
      "fillAnimation": "grow 1.2s cubic-bezier(0.16,1,0.3,1)"
    },
    "timeline": {
      "grid": "repeat(6,1fr)",
      "connector": "2px horizontal line at top 7px",
      "dot": {
        "size": "16x16px",
        "borderRadius": "50%",
        "default": "--bg with 2px solid --black border",
        "end": "gradient.primary fill, no border"
      }
    },
    "pill": {
      "size": "0.66rem",
      "weight": 700,
      "letterSpacing": "0.14em",
      "textTransform": "uppercase",
      "padding": "0.35rem 0.6rem",
      "background": "--coral",
      "color": "--white"
    },
    "hotcard": {
      "border": "1px solid rgba(255,255,255,0.16)",
      "padding": "1rem",
      "amount": {
        "size": "1.9rem",
        "weight": 900,
        "letterSpacing": "-0.04em"
      },
      "bulletMarker": "'— ' in --pink"
    }
  },
  "motion": {
    "scrollSnap": "y mandatory on <html>",
    "scrollBehavior": "smooth",
    "reduceMotion": "all animation/transition disabled via prefers-reduced-motion",
    "keyframes": {
      "grow": "scaleX from 0 to 1",
      "drop": "translateY(-8px) + opacity 0.001 → 1"
    },
    "orbs": {
      "role": "decorative background blobs",
      "background": "gradient.primary",
      "opacity": 0.09,
      "blur": "90px",
      "borderRadius": "50%",
      "pointerEvents": "none"
    }
  },
  "iconography": {
    "favicon": "SVG 32x32, black square + gradient circle inside",
    "gradientDot": "6x6px marker used after wordmarks"
  },
  "voice": {
    "language": "Spanish (Argentina)",
    "register": "declarativo, corto, punzante",
    "titlePattern": "frase de resultado + subtítulo en gradient-text",
    "titleExamples": [
      "Primer lote vendido. Dos más, en la mesa.",
      "De 306 mil impresiones a una venta."
    ],
    "dateFormat": "25 jun → 10 sep 2026 (lowercase months, arrow separator)",
    "currency": {
      "primary": "ARS",
      "secondary": "USD",
      "convention": "usar el punto como separador de miles; monto grande en la línea principal y equivalencia menor en 'small'"
    },
    "numbers": "usar font-variant-numeric: tabular-nums para todas las cifras"
  },
  "slideBackgrounds": {
    "s-black": {
      "bg": "--black",
      "text": "--white",
      "usage": "portada, pipeline (secciones de impacto o listado extenso sobre negro)"
    },
    "s-white": {
      "bg": "--white",
      "text": "--black",
      "usage": "venta, próximos pasos (secciones con timeline / decisiones)"
    },
    "s-bg": {
      "bg": "--bg",
      "text": "--black",
      "usage": "embudo, pauta (secciones con gráficos y comparativos)"
    }
  },
  "docVariant": {
    "color": {
      "pink": "#E8177A",
      "pinkSoft": "#fce8f1",
      "ink": "#1a1a1e",
      "muted": "#6b6b76",
      "bg": "#fafafa",
      "card": "#ffffff",
      "line": "#e8e8ec",
      "soft": "#f4f4f7",
      "ok": "#0f8a5f"
    },
    "typography": {
      "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,sans-serif",
      "base": { "size": "15px", "lineHeight": 1.65 },
      "kicker": {
        "color": "pink",
        "weight": 700,
        "size": "13px",
        "letterSpacing": "0.12em",
        "textTransform": "uppercase"
      },
      "h1": { "size": "34px", "weight": 800, "letterSpacing": "-0.02em" },
      "h2": { "size": "21px", "weight": 750, "letterSpacing": "-0.01em" },
      "h3": { "size": "16px", "weight": 700 },
      "sub": { "size": "16px", "color": "muted", "maxWidth": "640px" }
    },
    "layout": {
      "container": { "maxWidth": "860px", "paddingX": "20px", "paddingBottom": "80px" },
      "headerPadding": "56px 0 28px"
    },
    "components": {
      "tabs": {
        "gap": "6px",
        "borderBottom": "1px solid line",
        "item": {
          "font": "600 14.5px",
          "color": "muted",
          "padding": "10px 14px",
          "activeColor": "ink",
          "activeUnderline": "2.5px solid pink"
        }
      },
      "card": {
        "background": "card",
        "border": "1px solid line",
        "borderRadius": "12px",
        "padding": "24px 26px",
        "marginBottom": "18px"
      },
      "callout": {
        "borderLeft": "3px solid pink",
        "background": "soft",
        "borderRadius": "0 10px 10px 0",
        "padding": "14px 18px",
        "fontSize": "14.5px",
        "strongColor": "pink"
      },
      "flow": {
        "node": {
          "flex": 1,
          "minWidth": "150px",
          "background": "soft",
          "border": "1px solid line",
          "borderRadius": "10px",
          "padding": "14px",
          "textAlign": "center",
          "titleSize": "14px",
          "subSize": "12.5px",
          "subColor": "muted"
        },
        "arrow": { "color": "pink", "weight": 800, "size": "18px", "padding": "0 10px" }
      },
      "step": {
        "gap": "16px",
        "padding": "18px 0",
        "borderBottom": "1px solid line",
        "badge": {
          "size": "34px",
          "borderRadius": "50%",
          "background": "ink",
          "color": "#fff",
          "font": "700 15px"
        }
      },
      "table": {
        "fontSize": "13.8px",
        "th": {
          "size": "12px",
          "textTransform": "uppercase",
          "letterSpacing": "0.06em",
          "color": "muted",
          "borderBottom": "2px solid line",
          "padding": "8px 10px"
        },
        "td": { "borderBottom": "1px solid line", "padding": "9px 10px" },
        "firstColWeight": 600
      },
      "tag": {
        "background": "pinkSoft",
        "color": "pink",
        "fontSize": "11.5px",
        "weight": 700,
        "borderRadius": "20px",
        "padding": "2px 10px"
      },
      "code": {
        "background": "soft",
        "border": "1px solid line",
        "borderRadius": "5px",
        "padding": "1.5px 6px",
        "fontSize": "13px",
        "fontFamily": "'SF Mono',Menlo,Consolas,monospace"
      },
      "ok": { "color": "ok", "weight": 700 }
    },
    "sectionKinds": [
      "intro (kicker + h1 + sub)",
      "card (h2 + body blocks)",
      "flow (nodes with arrows between)",
      "steps (numbered items)",
      "callout (highlighted block)",
      "table (headers + rows)",
      "tabs (container of grouped sections)"
    ],
    "voice": {
      "register": "docs interno, explicativo, cercano",
      "kickerPattern": "'Break · <sistema/tema>'",
      "titleExamples": [
        "Circuito de datos automático",
        "Cómo fluye la data"
      ],
      "structure": "columna angosta de lectura, cards separadas por tema, callouts para 'por qué' y 'si algo no aparece'"
    }
  }
}
